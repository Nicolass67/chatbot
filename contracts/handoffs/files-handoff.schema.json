{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatbot.local/contracts/handoffs/files-handoff.schema.json",
  "title": "FilesHandoff",
  "type": "object",
  "required": ["intent", "reason"],
  "additionalProperties": false,
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["none", "search", "list", "read", "analyze", "organize"]
    },
    "reason": { "type": "string", "minLength": 1 },
    "query": { "type": "string" },
    "rootId": { "type": "string" },
    "url": { "type": "string", "description": "Deprecated Web path" }
  }
}
