# LM Studio (local uniquement — non exposé via tunnel)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# SQLite (local)
DATABASE_URL=./data/local.db
RUNTIME_MODE=local

# Web search (SearXNG local — non exposé via tunnel)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_CALLS_PER_REQUEST=2
WEB_SEARCH_TIMEOUT_MS=25000
WEB_SEARCH_PROVIDER=searxng
SEARXNG_URL=http://localhost:8080
# BRAVE_SEARCH_API_KEY=

# ── Dev local vs Production ─────────────────────────────────────────────
# Dev : CF_ACCESS_ENABLED=false, accès direct localhost
# Prod (Cloudflare Tunnel) : CF_ACCESS_ENABLED=true + JWT Access
# Voir docs/DEPLOYMENT.md pour le déploiement complet

# Cloudflare Access — laisser false en dev local
CF_ACCESS_ENABLED=false
# CF_ACCESS_TEAM_DOMAIN=votre-equipe.cloudflareaccess.com
# CF_ACCESS_AUD=

# Token interne pour automation (WoL futur) — optionnel
# HEALTH_CHECK_TOKEN=

# Email / Gmail OAuth (Personal AI Assistant V1)
# Laisser EMAIL_ENABLED=false tant que l'intégration n'est pas activée
EMAIL_ENABLED=false
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/gmail/callback
# PUBLIC_BASE_URL=http://localhost:3000
#   ↑ Obligatoire en prod OAuth (redirect callback Gmail)
# OAUTH_TOKEN_ENCRYPTION_KEY=  # 32 octets en base64 — secret machine uniquement, jamais commité
#   Perte de la clé = tokens chiffrés irrécupérables (reconnecter Gmail requis).

# Files / Document Assistant local (V1)
# Laisser FILES_ENABLED=false tant que les roots ne sont pas configurées
FILES_ENABLED=false

# ── Secrets à ne JAMAIS logger / exposer ────────────────────────────────
# - OAUTH_TOKEN_ENCRYPTION_KEY, GOOGLE_OAUTH_CLIENT_SECRET
# - Tokens OAuth (access/refresh), confirmationToken d'envoi email
# - Corps complets des emails dans les logs ou SSE (sanitisés côté serveur)
# Checklist E2E manuelle : docs/E2E-EMAIL-V1.md
