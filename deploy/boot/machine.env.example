# Copier vers deploy/boot/machine.env (gitignored)
# Le même token doit être configuré sur le Worker :
#   cd workers/chatbot && npx wrangler secret put BOOT_MACHINE_TOKEN

WORKER_BASE_URL=https://your-worker.example.workers.dev
BOOT_MACHINE_TOKEN=

# Si Cloudflare Access protège le Worker (requis en prod) :
# 1. Zero Trust → Access → Service Auth → Create Service Token
# 2. Policy Allow/Bypass sur /boot-request avec ce Service Token
# 3. Copier ici (même paire id/secret) :
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# Optionnel
LM_STUDIO_MODEL=qwen/qwen3.5-9b
NEXT_HEALTH_URL=http://127.0.0.1:3000/api/health
SEARXNG_URL=http://localhost:8080
